{
  "name": "sign-translator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ml:validate": "python3 ml/datasets/validate_dataset.py",
    "ml:train": "python3 ml/training/train.py",
    "ml:parity-fixture": "tsx scripts/generate-parity-fixture.ts && python3 ml/training/generate_model_parity_fixture.py",
    "ml:test": "python3 -m pytest ml/tests/ -v",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test && npm run ml:test",
    "prototypes": "tsx scripts/build-prototypes.ts",
    "prototypes:eval": "tsx scripts/build-prototypes.ts --held-out --out public/models/sign-vocabulary/sign-prototypes.eval.json"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@vercel/analytics": "^2.0.1",
    "mongodb": "^7.5.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
