# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ML artifacts (raw dataset must never be committed; it's user-provided)
/ml/data/raw/*.csv
__pycache__/
*.pyc
.pytest_cache/

# KArSL raw video dataset and its processed landmark output -- local-only,
# never committed (raw video especially can be gigabytes). The only output
# artifact that IS meant to be committed is public/models/sign-vocabulary/
# dedicated-signs.json, produced by ml/training/import_karsl.py.
/KArSL/
/processed-karsl/
/ml/training/.cache/